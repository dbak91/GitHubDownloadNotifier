<?xml version="1.0" encoding="utf-8"?>
<ScrollView xmlns:android="http://schemas.android.com/apk/res/android"
	android:layout_width="match_parent"
	android:layout_height="match_parent"
	android:fillViewport="true"
	android:fitsSystemWindows="true">

	<LinearLayout
		android:layout_width="match_parent"
		android:layout_height="wrap_content"
		android:orientation="vertical"
		android:padding="20dp">

		<TextView
			android:layout_width="match_parent"
			android:layout_height="wrap_content"
			android:text="@string/repository_details_section"
			android:textAppearance="@android:style/TextAppearance.Material.Headline" />

		<EditText
			android:id="@+id/repoOwnerEditText"
			android:layout_width="match_parent"
			android:layout_height="wrap_content"
			android:layout_marginTop="12dp"
			android:hint="@string/repo_owner_hint"
			android:inputType="text"
			android:maxLines="1" />

		<EditText
			android:id="@+id/repoNameEditText"
			android:layout_width="match_parent"
			android:layout_height="wrap_content"
			android:layout_marginTop="8dp"
			android:hint="@string/repo_name_hint"
			android:inputType="text"
			android:maxLines="1" />

		<LinearLayout
			android:layout_width="match_parent"
			android:layout_height="wrap_content"
			android:layout_marginTop="20dp"
			android:background="@drawable/download_section_background"
			android:orientation="vertical"
			android:padding="16dp">

		<TextView
			android:layout_width="match_parent"
			android:layout_height="wrap_content"
			android:text="@string/download_watcher_section"
			android:textAppearance="@android:style/TextAppearance.Material.Headline" />

		<Switch
			android:id="@+id/downloadEnabledSwitch"
			android:layout_width="match_parent"
			android:layout_height="wrap_content"
			android:layout_marginTop="8dp"
			android:text="@string/download_watcher_enabled" />

		<TextView
			android:layout_width="match_parent"
			android:layout_height="wrap_content"
			android:layout_marginTop="12dp"
			android:text="@string/interval_label" />

		<Spinner
			android:id="@+id/intervalSpinner"
			android:layout_width="match_parent"
			android:layout_height="wrap_content"
			android:layout_marginTop="6dp" />

		<LinearLayout
			android:id="@+id/customIntervalLayout"
			android:layout_width="match_parent"
			android:layout_height="wrap_content"
			android:layout_marginTop="6dp"
			android:orientation="horizontal"
			android:visibility="gone">

			<EditText
				android:id="@+id/customIntervalEditText"
				android:layout_width="0dp"
				android:layout_height="wrap_content"
				android:layout_weight="1"
				android:hint="@string/custom_interval_hint"
				android:inputType="number"
				android:maxLines="1" />

			<Spinner
				android:id="@+id/customIntervalUnitSpinner"
				android:layout_width="wrap_content"
				android:layout_height="wrap_content"
				android:layout_marginStart="8dp" />
		</LinearLayout>

		<Button
			android:id="@+id/runAtTimeButton"
			android:layout_width="match_parent"
			android:layout_height="wrap_content"
			android:layout_marginTop="6dp"
			android:visibility="gone" />

		<Switch
			android:id="@+id/allReleasesSwitch"
			android:layout_width="match_parent"
			android:layout_height="wrap_content"
			android:layout_marginTop="12dp"
			android:text="@string/release_scope_all" />

		<Switch
			android:id="@+id/alwaysNotifySwitch"
			android:layout_width="match_parent"
			android:layout_height="wrap_content"
			android:layout_marginTop="8dp"
			android:text="@string/notify_updates_only" />

		<Button
			android:id="@+id/testDownloadButton"
			android:layout_width="match_parent"
			android:layout_height="wrap_content"
			android:layout_marginTop="12dp"
			android:text="@string/test_notification_button" />

		<Switch
			android:id="@+id/downloadLoggingSwitch"
			android:layout_width="match_parent"
			android:layout_height="wrap_content"
			android:layout_marginTop="12dp"
			android:text="@string/log_each_interval" />

		<LinearLayout
			android:id="@+id/downloadLoggingOptions"
			android:layout_width="match_parent"
			android:layout_height="wrap_content"
			android:orientation="vertical"
			android:visibility="gone">

			<TextView
				android:id="@+id/downloadLogFileText"
				android:layout_width="match_parent"
				android:layout_height="wrap_content"
				android:layout_marginTop="6dp"
				android:text="@string/no_log_file_selected" />

			<Button
				android:id="@+id/downloadLogFileButton"
				android:layout_width="match_parent"
				android:layout_height="wrap_content"
				android:text="@string/choose_log_file" />

			<Button
				android:id="@+id/downloadLogFieldsButton"
				android:layout_width="match_parent"
				android:layout_height="wrap_content"
				android:text="@string/choose_log_fields" />
		</LinearLayout>
		</LinearLayout>

		<LinearLayout
			android:layout_width="match_parent"
			android:layout_height="wrap_content"
			android:layout_marginTop="16dp"
			android:background="@drawable/release_section_background"
			android:orientation="vertical"
			android:padding="16dp">

		<TextView
			android:layout_width="match_parent"
			android:layout_height="wrap_content"
			android:text="@string/release_watcher_section"
			android:textAppearance="@android:style/TextAppearance.Material.Headline" />

		<Switch
			android:id="@+id/releaseEnabledSwitch"
			android:layout_width="match_parent"
			android:layout_height="wrap_content"
			android:layout_marginTop="8dp"
			android:text="@string/release_watcher_enabled" />

		<EditText
			android:id="@+id/currentTagEditText"
			android:layout_width="match_parent"
			android:layout_height="wrap_content"
			android:layout_marginTop="6dp"
			android:hint="@string/current_tag_hint"
			android:inputType="text"
			android:maxLines="1" />

		<Spinner
			android:id="@+id/releaseIntervalSpinner"
			android:layout_width="match_parent"
			android:layout_height="wrap_content"
			android:layout_marginTop="6dp" />

		<EditText
			android:id="@+id/customReleaseDaysEditText"
			android:layout_width="match_parent"
			android:layout_height="wrap_content"
			android:layout_marginTop="6dp"
			android:hint="@string/custom_days_hint"
			android:inputType="number"
			android:maxLines="1"
			android:visibility="gone" />

		<Button
			android:id="@+id/releaseRunAtTimeButton"
			android:layout_width="match_parent"
			android:layout_height="wrap_content"
			android:layout_marginTop="6dp" />

		<Switch
			android:id="@+id/releaseLoggingSwitch"
			android:layout_width="match_parent"
			android:layout_height="wrap_content"
			android:layout_marginTop="12dp"
			android:text="@string/log_each_interval" />

		<LinearLayout
			android:id="@+id/releaseLoggingOptions"
			android:layout_width="match_parent"
			android:layout_height="wrap_content"
			android:orientation="vertical"
			android:visibility="gone">

			<TextView
				android:id="@+id/releaseLogFileText"
				android:layout_width="match_parent"
				android:layout_height="wrap_content"
				android:layout_marginTop="6dp"
				android:text="@string/no_log_file_selected" />

			<Button
				android:id="@+id/releaseLogFileButton"
				android:layout_width="match_parent"
				android:layout_height="wrap_content"
				android:text="@string/choose_log_file" />

			<Button
				android:id="@+id/releaseLogFieldsButton"
				android:layout_width="match_parent"
				android:layout_height="wrap_content"
				android:text="@string/choose_log_fields" />
		</LinearLayout>
		</LinearLayout>

		<Button
			android:id="@+id/saveRepositoryButton"
			android:layout_width="match_parent"
			android:layout_height="wrap_content"
			android:layout_marginTop="24dp"
			android:text="@string/save_repository_button" />
	</LinearLayout>
</ScrollView>
