<?xml version="1.0" encoding="utf-8"?>
<Project>
  <PropertyGroup>
	<Configuration>Release</Configuration>
	<Platform>Any CPU</Platform>
	<PublishDir>bin\Release\net10.0-android36.0\publish\android-arm64\</PublishDir>
	<PublishProtocol>FileSystem</PublishProtocol>
	<_TargetId>Folder</_TargetId>
	<TargetFramework>net10.0-android36.0</TargetFramework>
	<RuntimeIdentifier>android-arm64</RuntimeIdentifier>
	<SelfContained>true</SelfContained>
	<PublishSingleFile>false</PublishSingleFile>
	<PublishTrimmed>true</PublishTrimmed>
	<AndroidPackageFormats>apk</AndroidPackageFormats>
  </PropertyGroup>
	<Target Name="ValidateGithubDownloadNotifierReleaseSigning" BeforeTargets="PrepareForBuild">
	<Error Condition="'$(AndroidKeyStore)' != 'true' Or !Exists('$(AndroidSigningKeyStore)')"
		   Text="GithubDownloadNotifier release signing is missing. Restore the local release-signing directory before publishing." />
  </Target>
	<Target Name="VerifyGithubDownloadNotifierReleaseSignature" AfterTargets="_Sign">
	<Exec Command="&quot;$([System.IO.Path]::Combine('$(JavaToolPath)', 'java.exe'))&quot; -jar &quot;$(ApkSignerJar)&quot; verify &quot;$(ApkFileSigned)&quot;" />
  </Target>
</Project>
